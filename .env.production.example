# DEPLOYMATE Production Environment Template
# Mandatory variables MUST be set to unique, cryptographically random values.
# Do NOT place real production secrets in this file.

# Environment Mode
NODE_ENV=production
ENVIRONMENT=production
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=deploymate
DB_USER=postgres
DB_PASSWORD=<GENERATE_POSTGRES_SUPERUSER_PASSWORD>

# Dedicated Non-Superuser Application Role
DB_APP_USER=deploymate_app
DB_APP_PASSWORD=<GENERATE_APPLICATION_USER_PASSWORD>

# JWT Authentication Secret (Minimum 32 random hex bytes)
JWT_SECRET=<GENERATE_JWT_SECRET_KEY>

# Internal AI Microservice Authentication Token
AI_INTERNAL_TOKEN=<GENERATE_AI_INTERNAL_TOKEN>

# GitHub Webhook HMAC Secret
GITHUB_WEBHOOK_SECRET=<GENERATE_WEBHOOK_SECRET>

# Initial Super Admin Bootstrap Credentials
INITIAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_ADMIN_PASSWORD=<GENERATE_STRONG_ADMIN_PASSWORD>

# AI Module Configuration
AI_SERVICE_URL=http://ai-module:8000
AI_MODE=simulated
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY_OR_EMPTY_FOR_SIMULATED>

# Frontend Public Origin URL (for CORS and HTTPS header origin validation)
FRONTEND_URL=https://your-domain.com

# Nginx SSL Certificate Mount Paths (Mounted inside docker-compose.prod.yml)
SSL_CERT_PATH=./certs/fullchain.pem
SSL_KEY_PATH=./certs/privkey.pem
