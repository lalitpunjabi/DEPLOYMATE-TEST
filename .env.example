# Backend & DB Configuration
PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<set-a-local-postgres-password>
DB_APP_USER=deploymate_app
DB_APP_PASSWORD=<set-a-local-app-password>
DB_NAME=deploymate

# Security
JWT_SECRET=<set-a-unique-jwt-secret>
AI_INTERNAL_TOKEN=<set-a-unique-internal-token>
GITHUB_WEBHOOK_SECRET=<set-a-unique-webhook-secret>
INITIAL_ADMIN_EMAIL=you@localhost
# Leave INITIAL_ADMIN_PASSWORD empty in development to print a one-time generated password.
INITIAL_ADMIN_PASSWORD=

FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# AI module
GEMINI_API_KEY=
AI_MODE=simulated
